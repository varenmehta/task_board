# Everything below is optional — you can also enter all of it in the app under Settings → Workspace.
# Environment variables win over values saved in the UI.
PORT=3000
DATA_DIR=./data
BASE_URL=https://tasks.yourcompany.com   # public address, used in email links and OAuth callbacks

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+14155550100
TWILIO_WHATSAPP_FROM=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional tuning
SESSION_SECRET=            # defaults to a random value stored in data/.secret
VAPID_CONTACT=you@company.com   # contact address sent to push services
BACKUP_KEEP=7              # number of daily database backups to retain
ALLOW_PRIVATE_URLS=0       # set 1 only in dev: lets webhooks/push target localhost
